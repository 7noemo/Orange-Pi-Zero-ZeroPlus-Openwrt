+static void rtw_cfg80211_prepare_ndev_unregister(_adapter *adapter)
+{
+	struct net_device *ndev;
+
+	if (!adapter)
+		return;
+
+	ndev = adapter->pnetdev;
+	if (ndev) {
+		rtw_netif_carrier_off(ndev);
+		rtw_netif_stop_queue(ndev);
+	}
+
+	adapter->net_closed = _TRUE;
+	adapter->netif_up = _FALSE;
+
+	rtw_scan_abort(adapter);
+	rtw_cfg80211_wait_scan_req_empty(adapter, 200);
+
+#ifdef CONFIG_AP_MODE
+	if ((MLME_IS_AP(adapter) || MLME_IS_MESH(adapter)) && adapter->bup == _TRUE)
+		rtw_stop_ap_cmd(adapter, RTW_CMDF_WAIT_ACK);
+#endif
+
+	if (adapter->bup == _TRUE)
+		rtw_dev_unload(adapter);
+}
